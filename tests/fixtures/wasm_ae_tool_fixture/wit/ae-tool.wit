// wit/ae-tool.wit
//
// The `ae:tool` world (009-Plugin-and-Extension-System.md §2/§3/§5, 006-Tool-and-Function-Plane.md
// §1/§3/§7) -- the contract of record for a WASM component exposing one or more tools (schema +
// invoke) to the engine.
//
// Scope (Milestone 2 task D2, revised by task D3 / decisions/ADR-010-wasm-component-host-manifest-
// capability-binding.md): the world shape only for D2; D3 is the first host implementation
// (`src/backends/wasm/wasm_backend.{hpp,cpp}`), built through design->red-team->prove->judge per
// CLAUDE.md and landed as ADR-010. Narrowed to what an M2 native tool call actually is: synchronous
// and immediate. Progress reporting (006 §6a), scheduling/watch/background tools (§6b), and
// parallel-batch history ordering (§5's G4) all need 019's durability machinery and are explicitly
// deferred past M2 (docs/planning/milestone-2-tools-capabilities-sandbox-breakdown.md, "What's
// explicitly deferred past M2"). A later world revision adds those once 019 exists to back them,
// under 009 §2's declared N-1 deprecation-window policy -- this file does not speculate their shape
// now.
//
// **ADR-010 revision (2026-08-05): `host` no longer exists as a single interface.** D2's first draft
// bundled every host-mediated effect into one `host` interface; ADR-010 §5 F1 found this made
// per-capability manifest-vs-import verification unstatable, since the Component Model's import
// granularity is per-*interface*, not per-function, for a linked interface. Split into `base`
// (ungated) plus one interface per `007-Capability-and-Trust-Model.md` §3 capability kind this host
// actually implements (`fs`, `http`, `secrets`, `clock`, `random`). `blob` and `tool-call` stay
// declared -- 009 §5 lists both as host imports every `ae:tool` plugin may reach for -- but the
// `tool` world below does not import them: 007's `Capability` variant has no `Blob` kind yet, and
// `tool-call`'s "invoke another tool" needs dispatch machinery M2 does not build (ADR-010 §3.1). A
// component that references either fails Wasmtime's own component-type check against this world,
// not merely this host's own runtime check -- mechanical, not a promise.
//
// Four design choices below are NOT settled by either 009 or 007; each is made here and flagged,
// rather than cited as if the spec already said it:
//
//   1. Host imports (009 §5's `log` / `metrics` / `fs` / `http` / `tool-call` / `secrets` / `clock` /
//      `random` / `blob` list) are bespoke `ae:tool/*` functions, not raw `wasi:filesystem` /
//      `wasi:http` / `wasi:clocks` / `wasi:random`. Neither 008 nor 009 states this either way; the
//      choice follows 009 §5's own framing of the list as *named and capability-intersected per
//      invocation*, a shape standard WASI interfaces have no vocabulary for (no manifest-declared
//      request, no per-call attenuation to a bound grant).
//   2. Capability handles are WIT `resource` values, not opaque strings or bare integers. This is
//      what makes 007 §3.4's "unforgeable" property real at the ABI boundary instead of a promise
//      kept only by host-side discipline: a `resource` can only be constructed host-side and is
//      transferred into a call, never fabricated by the guest from a bare value -- the literal
//      ABI-level shape of I2 (no ambient authority), not merely consistent with it.
//   3. `blob-ref` and the `tainted` flag mirror 003's native `BlobRef{digest, media_type, size,
//      store}` and `ContentItem.tainted: bool` shapes field-for-field, so the host's normalize step
//      (006 §3 step 9) is a direct mapping, never a lossy re-encoding. WIT has no equivalent to the
//      native `Tainted<T>` compile-time wrapper (007 §4's G3 compile-fail property) -- only the flag
//      crosses the boundary; the host re-applies the real type-level guarantee on its own side.
//   4. One capability kind = one WIT interface (ADR-010 §3.1), so "this component imports `ae:tool/
//      fs`" and "the manifest requests `FsRead`/`FsWrite`" are the same fact checked two ways, not
//      two independent claims that could drift. `fs_read`/`fs_write` share one interface (both are
//      filesystem access, distinguished by which function -- `fs-read` vs `fs-write` -- is called,
//      matching 007 §3's own FsRead/FsWrite split at the parameter level, not the interface level).

package ae:tool@1.0.0;

/// Shared content and error vocabulary, reused by every interface below.
interface types {
    /// 003's BlobRef: a pointer to content-addressed storage, never inline bytes above 006 §7's
    /// token-budget threshold.
    record blob-ref {
        digest: string,
        media-type: string,
        size: u64,
        store: string,
    }

    /// 006 §7's "Data content item with a schema" -- schema-id is a reference to a schema the tool
    /// already declared (guest.tool-descriptor's result-schema-json), never an embedded schema body.
    record data-content {
        json: string,
        schema-id: option<string>,
    }

    /// One unit of text output. `tainted` mirrors 003's `ContentItem.tainted` flag -- see design
    /// choice 3 above for why this crosses as a flag, not the native wrapper type.
    record text-item {
        text: string,
        tainted: bool,
    }

    /// A single unit of tool output, normalized host-side (006 §3 step 9) from whichever of these a
    /// component produced.
    variant content-item {
        text(text-item),
        data(data-content),
        blob(blob-ref),
    }

    /// 006 §3 step 9's `ToolResult{is_error}` shape.
    record tool-result {
        content: list<content-item>,
        is-error: bool,
    }

    /// The error classes a component's own `invoke` can report about itself. Deliberately small:
    /// 006 §8 G2's full negative-suite classes (unknown name, schema violation, capability not held,
    /// approval mismatch, deadline exceeded, oversized result) are resolved *before* a component is
    /// ever called -- see 006 §3's step split, host steps 1-7 wrap every invoke. A component only
    /// ever raises what only it can detect: a call for a tool name it does not implement, or its own
    /// logic failing.
    enum invoke-error {
        unknown-tool,
        internal,
    }
}

/// The capability-handle resource type, factored into its own interface (ADR-010 §6) now that no
/// single interface owns every function that references it. One pre-materialized grant, opaque to
/// the guest. 007 §3's capability kinds (`FsRead<mount>`, `FsWrite<mount>`, `NetOut<host>`,
/// `Secret<name>`, `Clock`, `Entropy`) are resolved host-side, with their parameters (mount,
/// allowlisted host, secret name, ...) bound before the guest ever sees a handle; the guest supplies
/// only the part of a call the host must still validate per-call (a path within the granted mount),
/// never the grant's own parameters. Scoped to exactly one `invoke` call (006 §3 step 7's bind /
/// step 10's revoke) -- `own<capability-handle>` ownership is transferred in with the call and there
/// is no guest-side operation that produces a new one or extends its lifetime.
interface capability {
    resource capability-handle;
}

/// Always linked, ungated -- no capability request needed (matches 006 §6a's framing of progress/
/// telemetry as "not a new capability... attribution about an effect already authorized," extended
/// here to the plugin ABI's own diagnostics).
interface base {
    enum log-level {
        debug,
        info,
        warn,
        error,
    }

    log: func(level: log-level, message: string);
    record-metric: func(name: string, value: f64);
}

/// `fs` (009 §5), gated by `FsRead`/`FsWrite` (007 §3) -- read/write within a granted, preopened
/// mount only, never an arbitrary host path (009 §5's "not available in any world" list).
interface fs {
    use capability.{capability-handle};

    enum fs-error {
        not-found,
        permission-denied,
        quota-exceeded,
        invalid-path,
    }

    fs-read: func(cap: borrow<capability-handle>, path: string) -> result<list<u8>, fs-error>;
    fs-write: func(cap: borrow<capability-handle>, path: string, data: list<u8>) -> result<_, fs-error>;
}

/// `http` (009 §5), gated by `NetOut<host>` -- host-mediated egress, allowlisted. No raw socket ever
/// reaches the guest.
interface http {
    use capability.{capability-handle};

    record http-request-data {
        method: string,
        path: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record http-response-data {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    enum http-error {
        host-not-allowlisted,
        byte-cap-exceeded,
        network-error,
        timeout,
    }

    http-request: func(cap: borrow<capability-handle>, req: http-request-data) -> result<http-response-data, http-error>;
}

/// `secrets` (009 §5), gated by `Secret<name>` -- resolves one granted name at point of use, never
/// handed to the guest ahead of the call that needs it, never cached guest-side.
interface secrets {
    use capability.{capability-handle};

    enum secret-error {
        not-found,
        denied,
    }

    resolve-secret: func(cap: borrow<capability-handle>) -> result<string, secret-error>;
}

/// `clock` (009 §5), gated by `Clock` -- virtualizable, so a replayed run (I5) sees the recorded
/// value instead of the host's real clock.
interface clock {
    use capability.{capability-handle};

    now-unix-millis: func(cap: borrow<capability-handle>) -> u64;
}

/// `random` (009 §5), gated by `Entropy` -- virtualizable for the same I5 reason as `clock`.
interface random {
    use capability.{capability-handle};

    random-bytes: func(cap: borrow<capability-handle>, count: u32) -> list<u8>;
}

/// `blob` (009 §5): content-addressed read/write (003 §3). Declared for contract completeness --
/// 009 §5 lists it as a host import every `ae:tool` plugin may reach for -- but 007's `Capability`
/// variant has no `Blob` kind yet (ADR-010 §3.1), so the `tool` world below does not import this
/// interface. A future ADR that gives blob access a real 007 capability kind is what makes that
/// import real; until then a component that references it fails to link against this world's own
/// type, before any host runtime check runs at all.
interface blob {
    use capability.{capability-handle};
    use types.{blob-ref};

    enum blob-error {
        not-found,
        store-unavailable,
    }

    blob-read: func(cap: borrow<capability-handle>, blob: blob-ref) -> result<list<u8>, blob-error>;
    blob-write: func(cap: borrow<capability-handle>, media-type: string, data: list<u8>) -> result<blob-ref, blob-error>;
}

/// `tool-call` (009 §5): invoke another tool, executing at *this plugin's* trust tier, never the
/// calling agent's -- 009 §5 is explicit this is not a privilege-escalation path. Declared for
/// contract completeness, not imported by the `tool` world below (ADR-010 §3.1): the recursive
/// tool-dispatch machinery this needs (006 §6b's `ToolCall` capability, the dispatch pipeline itself)
/// does not exist yet in M2.
interface tool-call {
    use capability.{capability-handle};
    use types.{tool-result, invoke-error};

    call-tool: func(cap: borrow<capability-handle>, tool-name: string, args-json: string) -> result<tool-result, invoke-error>;
}

/// What a component exports. Named `guest` (not `tool`) so the world below -- itself named `tool`,
/// matching manifest.toml's `world = "ae:tool@1.0.0"` (009 §3) under the single-world-package
/// shorthand, since this package declares exactly one world -- reads as "the `tool` world exports
/// the `guest` interface" rather than colliding the same name at both levels.
interface guest {
    use types.{tool-result};
    use capability.{capability-handle};

    /// One tool's shape, schema-first per 006 §1 ("schemas... derived... emitted as JSON Schema
    /// 2020-12"). `args-schema-json` / `result-schema-json` are that JSON Schema 2020-12 text, not a
    /// second WIT-typed schema language -- a component's binary export is the source of truth 009
    /// §4's load-time check validates the package's bundled `schema/` files against, catching drift
    /// between what a manifest claims and what the binary actually implements.
    record tool-descriptor {
        name: string,
        description: string,
        args-schema-json: string,
        result-schema-json: string,
        /// 009 §9 Q3 (resolved): true exactly when this tool's manifest-declared capability request
        /// is empty -- a zero-capability tool has no way to observe or affect anything outside its
        /// own call arguments, so concurrent invocations are provably order-independent, not merely
        /// asserted safe by the plugin author.
        parallelizable: bool,
    }

    /// 009 §4's load-time step: the host calls this once per instantiation to discover what the
    /// component actually implements, before ever routing a call to it.
    list-tools: func() -> list<tool-descriptor>;

    record invoke-request {
        tool-name: string,
        /// Pre-validated against `tool-descriptor.args-schema-json` by the host (006 §3 step 2) --
        /// a component's `invoke` never re-validates what the pipeline already rejected or accepted.
        args-json: string,
        /// Bound at 006 §3 step 7, exactly the capabilities this one call needs -- never the plugin's
        /// full manifest-granted set (007 §3's attenuation-only rule applies per call, not per
        /// component instance).
        capabilities: list<capability-handle>,
        run-id: string,
        span-id: string,
    }

    /// 006 §3 step 8, exactly: resolve, validate, taint, authorize, approve, and admit (steps 1-6)
    /// already happened; normalize and account (steps 9-10) happen after this returns, host-side. A
    /// component's `invoke` never sees, and cannot affect, its own accounting or approval history.
    invoke: func(request: invoke-request) -> tool-result;
}

world tool {
    import base;
    import fs;
    import http;
    import secrets;
    import clock;
    import random;
    // blob and tool-call are declared (interface blob / interface tool-call, both present in this
    // file) but deliberately not imported here -- see ADR-010 §3.1. A component built against a WIT
    // snapshot that still references them fails Wasmtime's own component-type check before this
    // host's manifest logic ever runs; a component honestly built against *this* world file cannot
    // reference them at all, because the world does not make them available to import.

    export guest;
}
